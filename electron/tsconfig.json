{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "./",
    "outDir": "../dist-electron",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "sourceMap": true,
    "types": ["node"],
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true
  },
  "include": ["./**/*.ts"]
}
